@{ ViewData["Title"] = "Sensor investigation"; ViewData["Page"] = "sensor-details"; }
<div class="page-heading"><div><span class="eyebrow" id="device-id">DEVICE / INVESTIGATION</span><h1 id="device-name">Opening sensor…</h1><p id="device-location">Loading deployment context.</p></div><div class="toolbar"><a class="button" id="edit-link" href="/Sensors">Edit configuration</a><a class="button primary" id="history-link" href="/Telemetry/History">Inspect history ↗</a></div></div>
<div id="device-metrics" class="metrics"></div><section class="panel"><div class="panel-head"><div><span class="eyebrow">RECENT SIGNAL</span><h2>In context</h2></div><span id="device-type" class="tag"></span></div><div id="chart" class="chart"></div></section>
<div class="dashboard-grid bottom-grid"><section class="panel form-panel"><span class="eyebrow">DEVICE EVIDENCE</span><h2>Configuration & attachments</h2><p class="muted">Encrypted configuration files, hardware logs and deployment photos. Maximum 8 MiB per file.</p><form id="upload-form"><label class="upload-zone" for="attachment"><span>＋ Choose a file</span><small>JSON, text, logs, CSV, YAML, INI, CFG, PNG or JPEG</small><input id="attachment" type="file" required accept=".json,.txt,.log,.csv,.yaml,.yml,.ini,.cfg,.png,.jpg,.jpeg" /></label><div class="toolbar"><button class="button primary">Attach securely ↗</button><button class="button" type="button" id="cancel-upload" hidden>Cancel upload</button></div><div id="upload-status" role="status" class="muted"></div></form><div id="attachments" class="attachment-list"></div></section><section class="panel form-panel"><span class="eyebrow">HUMAN OBSERVATION</span><h2>Leave an investigation note.</h2><p class="muted">Report what the readings cannot tell us: a loose connection, damaged sensor or unexpected condition.</p><form id="issue-form"><label for="issue-text">Issue description<textarea id="issue-text" required maxlength="1000" rows="5" placeholder="Describe what needs attention…"></textarea></label><button class="button primary">Add to issue journal ↗</button></form></section></div>
