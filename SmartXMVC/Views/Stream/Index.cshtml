@{ ViewData["Title"] = "Command stream"; ViewData["Page"] = "stream"; }
<div class="stream-heading"><div><span class="eyebrow">OPERATIONS / PILLAR 02</span><h1>Read the signal.<br /><em>Make the next move.</em></h1><p>A live command desk for the Rivonia greenhouse.</p></div><div class="desk-stamp"><span class="dot"></span> DEVICE EMULATOR<small id="stream-updated">Awaiting first snapshot</small><button id="stream-pause" class="button compact">Pause view</button></div></div>
<div class="stream-ribbon" id="stream-metrics" aria-label="Live processing metrics"><p class="loading">Connecting to the processing engine…</p></div>
<div class="command-desk">
<section class="fleet-column" aria-labelledby="fleet-title"><div class="desk-section-title"><span class="eyebrow">01 / LIVE FLEET</span><h2 id="fleet-title">Find your signal</h2></div>
<form id="stream-filter"><label for="stream-search">Device ID or name<input id="stream-search" maxlength="100" placeholder="Try SX-0003 or irrigation" /></label><div class="filter-pair"><label>Category<select id="stream-category"><option value="">All devices</option><option value="Environmental">Environment</option><option value="PowerConsumption">Power</option><option value="Actuator">Actuators</option></select></label><label>Health<select id="stream-health"><option value="">All states</option><option>Healthy</option><option>Anomalous</option><option>Disconnected</option><option>Waiting</option></select></label></div><button class="button compact" type="submit">Apply filters ↗</button><button class="button compact" type="button" id="stream-clear">Clear</button></form>
<div id="stream-devices" class="fleet-list" aria-live="off"><p class="empty">Loading devices…</p></div><div class="fleet-pagination"><button id="stream-prev" class="button compact" aria-label="Previous device page">←</button><span id="stream-page" class="mono"></span><button id="stream-next" class="button compact" aria-label="Next device page">→</button></div>
</section>
<div class="signal-column"><section class="signal-panel"><div class="desk-section-title signal-title"><div><span class="eyebrow">02 / SIGNAL DETAIL</span><h2 id="stream-device-name">Select a device</h2><span id="stream-device-meta" class="mono muted"></span></div><div class="signal-reading" id="stream-value">—</div></div><div id="chart" class="chart"></div><div class="signal-caption"><span id="stream-range">Timestamp-ordered sensor history</span><a id="stream-inspect" href="/Sensors/Details/SX-0001">Full investigation ↗</a></div>
<div class="override-bar"><div><span class="eyebrow">MANUAL OVERRIDE</span><p id="override-state">Choose an actuator to issue a command.</p></div><div class="toolbar"><button id="command-open" class="button primary" disabled>Open valve</button><button id="command-close" class="button" disabled>Close valve</button></div></div><p class="command-hint">Commands set the emulator’s requested state. The next telemetry packet confirms the observed state. Undo returns to the prior override or automatic mode.</p></section>
<section class="insight-panel"><div class="desk-section-title"><span class="eyebrow">03 / SUGGESTED ACTIONS</span><h2>One step ahead<span class="experimental">EXPLAINABLE</span></h2></div><div id="stream-insights"><p class="empty">Gathering evidence…</p></div></section>
</div></div>
<section class="history-panel"><div class="desk-section-title signal-title"><div><span class="eyebrow">04 / COMMAND HISTORY</span><h2>Every decision, traceable.</h2></div><div class="toolbar"><button id="stream-export" class="button compact">Export history ↓</button><button id="command-undo" class="button compact" disabled>Undo last command ↶</button></div></div><div class="table-wrap"><table><thead><tr><th>Issued / UTC</th><th>Device</th><th>Requested state</th><th>Previous mode</th><th>Status</th></tr></thead><tbody id="stream-history"><tr><td colspan="5" class="empty">No manual commands yet.</td></tr></tbody></table></div></section>
<section class="stream-lab"><div><span class="eyebrow">CONTROLLED EXPERIMENT</span><h2>Put the stream under pressure.</h2><p>Send real HTTP packets to dedicated demo devices. Existing greenhouse devices keep their own sequences.</p></div><div class="toolbar"><button id="stream-burst" class="button">Send 120 normal packets</button><button id="stream-spike" class="button">Inject critical power spike</button><button id="stream-recover" class="button">Recover demo meter</button><button id="stream-trend" class="button">Generate rising trend</button></div><p id="stream-lab-result" role="status" class="mono muted">Ready when you are.</p></section>
<dialog id="command-dialog"><form method="dialog"><span class="eyebrow">CONFIRM OVERRIDE</span><h2 id="command-confirm-title">Review command</h2><p id="command-confirm-detail"></p><div class="toolbar"><button class="button" value="cancel">Cancel</button><button class="button primary" id="command-confirm" value="confirm">Apply override</button></div></form></dialog>
