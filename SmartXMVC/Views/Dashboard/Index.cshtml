@{
    ViewData["Title"] = "Operations"; ViewData["Page"] = "dashboard";
}
<div class="page-heading"><div><div class="eyebrow">FACILITY A / LIVE OPERATIONS</div><h1>The signal room<span class="accent">.</span></h1><p>From incoming readings to a focused next action.</p></div><div class="toolbar"><button id="pause-view" class="button">Pause view</button><a class="button primary" href="/Sensors/Create">Register sensor +</a></div></div>
<div id="metrics" class="metrics"><div class="loading">Connecting to your gateway…</div></div>
<div class="dashboard-grid"><section class="panel trend-panel"><div class="panel-head"><div><span class="eyebrow">SIGNAL / TIME SERIES</span><h2>Live telemetry</h2></div><form id="trend-form" class="inline-form"><label class="sr-only" for="trend-id">Sensor identifier</label><input id="trend-id" value="SX-0001" maxlength="64" /><button class="button compact">Inspect</button></form></div><div class="chart-meta"><span id="trend-name" class="mono">SX-0001</span><span id="trend-current" class="big-reading">—</span></div><div id="chart" class="chart"><p class="muted">Waiting for telemetry…</p></div><div class="chart-footer"><span id="chart-range">Received samples · UTC</span><a id="trend-link" href="/Sensors/Details/SX-0001">Open sensor profile ↗</a></div></section><section class="panel"><div class="panel-head"><div><span class="eyebrow">NEEDS YOUR ATTENTION</span><h2>Signal watch</h2></div><span class="small-square amber">!</span></div><div id="watchlist" class="watchlist"><p class="loading">Loading sensors…</p></div></section></div>
<div class="dashboard-grid bottom-grid"><section class="panel"><div class="panel-head"><div><span class="eyebrow">EVENTS / INVESTIGATION</span><h2>Recent alerts</h2></div><span class="mono muted">LATEST 12</span></div><div id="alerts" class="alert-list"></div></section><section class="panel simulation-panel"><span class="eyebrow">SIMULATION CONTROL</span><h2>A living test environment.</h2><p>Observe normal behaviour, then introduce spikes or sensor dropouts to exercise the gateway.</p><label for="scenario">Scenario</label><select id="scenario"><option>Mixed</option><option>Normal</option><option>Spikes</option><option>Disconnects</option></select><div class="toolbar"><button class="button primary" id="sim-start">Run scenario ↗</button><button class="button" id="sim-stop">Stop</button></div><div id="sim-state" class="mono muted">Waiting for state…</div><div class="annotation">Pausing the simulation stops device packets. Health monitoring continues, so disconnected states are expected.</div></section></div>
